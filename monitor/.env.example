# Copy to .env and fill in (never commit .env)
#
# SSH defaults for Engineer — Contrôle à Distance (optional)
VITE_SSH_DEFAULT_HOST=
VITE_SSH_DEFAULT_USER=root
VITE_SSH_DEFAULT_PASSWORD=
#
# When using `vite preview` or a production build, run in another terminal:
#   npm run ssh-bridge
# Then point the app at the bridge:
VITE_SSH_WS_URL=ws://127.0.0.1:8765
